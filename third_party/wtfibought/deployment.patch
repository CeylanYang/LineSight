+import { useUserStore } from './stores/userStore'
 import { ToastProvider } from './components/ui/toast.tsx'
 
-createRoot(document.getElementById('root')!).render(
+async function mount() {
+  const base = import.meta.env.BASE_URL;
+  const previous = useUserStore.getState().token;
+  const response = await fetch(`${base}api/auth/linesight`, { method: "POST", credentials: "same-origin", headers: { "X-Lang": "zh", ...(previous ? { satoken: previous } : {}) } });
+  if (response.status === 401 || response.status === 403 || response.redirected) {
+    if (sessionStorage.getItem('wiib-sso-retry')) throw new Error("Session unavailable");
+    sessionStorage.setItem('wiib-sso-retry', '1');
+    window.location.replace(`${base}oauth2/start?rd=${encodeURIComponent(base)}`); return;
+  }
+  if (!response.ok) throw new Error("Service unavailable");
+  const result = await response.json();
+  if (result.code !== 0 || typeof result.data !== "string") throw new Error("SSO unavailable");
+  sessionStorage.removeItem('wiib-sso-retry');
+  useUserStore.getState().setUser(null);
+  useUserStore.getState().setToken(result.data);
+  createRoot(document.getElementById('root')!).render(
   <ToastProvider>
     <App />
   </ToastProvider>,
 )
+
+}
+void mount().catch(() => {
